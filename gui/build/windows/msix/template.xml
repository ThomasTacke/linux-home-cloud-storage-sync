<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="homesync"
        Arguments=""
        InstallLocation="C:\Program Files\s3r3nity-labs\Home Sync">
    </Installer>
    <PackageInformation
        PackageName="Home Sync"
        PackageDisplayName="Home Sync"
        PublisherName="CN=s3r3nity-labs"
        PublisherDisplayName="s3r3nity-labs"
        Version="0.1.0.0"
        PackageDescription="Keeps your folders in your cloud storage, linked into your home">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="org.s3r3nity.homesync"
                Description="Keeps your folders in your cloud storage, linked into your home"
                DisplayName="Home Sync"
                ExecutableName="homesync"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Home Sync</DisplayName>
            <PublisherDisplayName>s3r3nity-labs</PublisherDisplayName>
            <Description>Keeps your folders in your cloud storage, linked into your home</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="homesync.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
