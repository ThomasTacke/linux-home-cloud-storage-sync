{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 6"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Go modules: minor and patch updates in one weekly PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go modules"
    },
    {
      "description": "GitHub Actions: minor and patch updates (new SHA, version comment) in one weekly PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The go directive in go.mod is the minimum Go version for building, not a dependency: raise it on purpose only",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": false
    }
  ]
}
